# ---------------------------------------------------------------------------
# BHOOMI NAYAN — environment
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL 16+ with PostGIS 3.4+
# Homebrew PostgreSQL uses your OS username and no password.
# Replace YOUR_USER with the output of `whoami`:
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/bhoomi_nayan?schema=public"
# Docker Compose default:
# DATABASE_URL="postgresql://bhoomi:bhoomi@localhost:5432/bhoomi_nayan?schema=public"

# Session signing key (HS256 via jose). The name is historical — the app does
# not use NextAuth. Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-openssl-rand-base64-32"

# Document storage. Files are AES-256-GCM encrypted on local disk under
# STORAGE_ROOT. Only the local driver exists today — the S3_* values below are
# not read yet (docker-compose starts MinIO for when an S3 driver is added).
STORAGE_ROOT=".storage"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="bhoomi-documents"

# ML service
ML_SERVICE_URL="http://localhost:8000"

# Bhoomi Mitra — the assistant runs on Groq. Required for the chat widget.
# Get your key from https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# --- Integrations -----------------------------------------------------------
# Live Bhu-Naksha cadastral API. 14 of 36 states verified reachable.
# Set false to force the mock adapter.
CADASTRAL_LIVE_ENABLED="true"
CADASTRAL_TIMEOUT_READ_MS="5000"
# Per-host TLS exceptions (expired or broken state certificates) are a fixed
# list in backend/integrations/http.ts, not an env setting — never disable
# TLS checks globally.

# Mocked because these need government credentials we do not have.
LAND_RECORDS_MODE="mock"
PAYMENTS_MODE="mock"
EGAZETTE_MODE="mock"
SMS_MODE="mock"
EMAIL_MODE="mock"
